      },
      "wires": [
        ["nginx.req", "router.req"],
        ["router.page", "session.req"],
        ["router.api", "session.req"],
        ["router.page", "handler.req"],
        ["session.viewer", "handler.viewer"],
        ["handler.query", "db.query"],
        ["handler.view", "render.view"],
        ["db.rows", "render.rows"],
        ["router.ai", "token_gate.bearer"],
        ["token_gate.scope", "exporter.scope"],
        ["db.plan", "exporter.plan"],
        ["exporter.outline", "claude.context"]
      ]
    },
    "db": {
      "nodes": {
        "pool":  { "kind": "machine", "status": "done", "note": "one pool in AppState", "in": {}, "out": { "conn": "Pool" } },
