      "wires": [["pool.conn", "posts.conn"], ["pool.conn", "plans.conn"]]
    }
  },
  "layout": {
    "main/nginx": [1, 6], "main/router": [13, 5], "main/session": [25, 12], "main/token_gate": [25, 22],
