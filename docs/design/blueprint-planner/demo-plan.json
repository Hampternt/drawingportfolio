        "token_gate": { "kind": "machine", "status": "planned", "note": "bp_ token to scope; never a cookie",
                        "in": { "bearer": "Header" }, "out": { "scope": "Scope" } },
        "handler":    { "kind": "machine", "status": "done", "note": "one effective viewer",
