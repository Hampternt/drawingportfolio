{
  "v": 1,
  "root": "main",
  "graphs": {
    "main": {
      "nodes": {
        "nginx":      { "kind": "machine", "status": "done", "note": "TLS, static cache, body limit",
                        "in": { "https": "Request" }, "out": { "req": "Request", "static": "File" } },
        "router":     { "kind": "machine", "status": "done", "note": "axum Router; ai routes to add",
